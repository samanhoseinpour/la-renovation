# Neon Postgres (Vercel Marketplace). Local dev points at the Neon
# development branch, production at the main branch.
DATABASE_URL=

# better-auth. Generate a distinct secret per environment:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 in dev, https://arazconstructiongroup.com in production.
BETTER_AUTH_URL=

# HMAC key for contact rate-limit IP hashing. Separate from
# BETTER_AUTH_SECRET so either can rotate alone.
RATE_LIMIT_SECRET=

# Resend (Vercel Marketplace). CONTACT_FROM_EMAIL needs the verified domain,
# e.g. "Araz Construction Group <notifications@arazconstructiongroup.com>".
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# shadcnblocks private registry (components.json).
SHADCNBLOCKS_API_KEY=
